[Unit]
Description=Seungje Lee resume website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@RUN_USER@@
Group=@@RUN_GROUP@@
WorkingDirectory=@@DEPLOY_ROOT@@/current
EnvironmentFile=@@DEPLOY_ROOT@@/shared/resume.env
ExecStart=/usr/bin/node server/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@DEPLOY_ROOT@@/shared

[Install]
WantedBy=multi-user.target
